{
  "manifest_version": 3,
  "name": "AI Brain Capture",
  "version": "0.22.1",
  "description": "Capture the exact active YouTube or article tab into the local AI Brain vault.",
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Add to Brain"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "vendor/defuddle.js",
        "youtube-defuddle.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
