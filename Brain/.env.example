# Optional override. Transcribe's published agent API currently needs no API key.
USETRANSCRIBE_BASE_URL=https://www.usetranscribe.io

# Ask My Brain hosted LLM settings.
# Copy this file to .env and put your real OpenRouter key there.
# Never commit .env; it is intentionally ignored by git.
AIBRAIN_LLM_MODE=hosted
AIBRAIN_HOSTED_BASE_URL=https://openrouter.ai/api/v1
AIBRAIN_HOSTED_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AIBRAIN_HOSTED_API_KEY=
AIBRAIN_ASK_TIMEOUT_SECONDS=120
AIBRAIN_REMOTE_ASK_HOST=127.0.0.1
AIBRAIN_REMOTE_ASK_PORT=8766

# Optional command run after a source note is written.
# The captured source path is passed in AIBRAIN_CAPTURED_SOURCE.
# AIBRAIN_INGEST_COMMAND=
